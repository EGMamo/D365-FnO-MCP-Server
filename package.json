{
  "name": "d365-fno-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for D365 Finance & Operations developers",
  "keywords": [
    "d365",
    "fno",
    "mcp",
    "modelcontextprotocol",
    "x++",
    "dynamics365",
    "finance-and-operations"
  ],
  "bin": {
    "d365-fno-mcp-server": "dist/src/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "build:agents": "node scripts/build-agents.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "serve": "node dist/src/index.js serve",
    "doctor": "node dist/src/index.js doctor",
    "index": "node dist/src/index.js index",
    "index-xref": "node dist/src/index.js index-xref",
    "digest": "node dist/src/index.js digest",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "glob": "^13.0.6",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "mssql": "^12.7.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "agents",
    "d365-fno-assistant-knowledge/README.md",
    "d365-fno-assistant-knowledge/resources/*.md",
    ".env.example",
    "README.md",
    "llms-install.md",
    "LICENSE"
  ],
  "allowScripts": {
    "esbuild": false
  }
}
