{
  "name": "d365-fno-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for D365 Finance & Operations developers",
  "keywords": [
    "d365",
    "fno",
    "mcp",
    "modelcontextprotocol",
    "x++",
    "dynamics365",
    "finance-and-operations"
  ],
  "bin": {
    "d365-fno-mcp-server": "dist/src/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "serve": "node dist/src/index.js serve",
    "doctor": "node dist/src/index.js doctor",
    "index": "node dist/src/index.js index",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^4.5.1",
    "glob": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "d365-fno-assistant-knowledge/README.md",
    "d365-fno-assistant-knowledge/resources/*.md",
    ".env.example",
    "README.md",
    "LICENSE"
  ]
}
