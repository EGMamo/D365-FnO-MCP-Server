<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
                <Style TargetType="Label" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogLabelStyleKey}}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,0,8,0" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}">
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}">
                    <Setter Property="Margin" Value="6,3,0,3" />
                    <Setter Property="Padding" Value="10,2" />
                    <Setter Property="MinWidth" Value="75" />
                </Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}">
                    <Setter Property="Margin" Value="0,4" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}">
                    <Setter Property="Margin" Value="0,3" />
                </Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,10">
                <Run Text="Server: " /><Run Text="{Binding ServerUrl, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="  (change it with Extensions &gt; D365 F&amp;O MCP &gt; Configure Connection)" />
            </TextBlock>

            <!-- 1. What to index -->
            <GroupBox Grid.Row="1" Header="1. Index" IsEnabled="{Binding IsIdle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="PackagesLocalDirectory:" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PackagesDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowsePackagesCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Content="Detect" Command="{Binding DetectPackagesCommand}" />

                    <Label Grid.Row="1" Content="Index database:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IndexDbPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseIndexCommand}" />

                    <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" IsChecked="{Binding NewIndex}"
                              Content="Build a new index (delete the existing database first instead of updating it)" />
                </Grid>
            </GroupBox>

            <!-- 2. XRef database -->
            <GroupBox Grid.Row="2" Header="2. Cross-reference database (DYNAMICSXREFDB)" IsEnabled="{Binding IsIdle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.ColumnSpan="3" IsChecked="{Binding ImportXref}"
                              Content="Import compiler cross-references (find_usages) from the XRef database" />

                    <Label Grid.Row="1" Content="SQL Server:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding XrefServer, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ImportXref}"
                             ToolTip="localhost, a named instance such as .\SQLEXPRESS, or (localdb)\MSSQLLocalDB" />

                    <Label Grid.Row="2" Content="Database:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding XrefDatabase, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ImportXref}" />

                    <Label Grid.Row="3" Content="Authentication:" />
                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding XrefAuthenticationIndex}" IsEnabled="{Binding ImportXref}">
                        <ComboBoxItem Content="Windows (current user; needs the msnodesqlv8 driver next to the CLI)" />
                        <ComboBoxItem Content="SQL login" />
                    </ComboBox>

                    <Label Grid.Row="4" Content="SQL login:" Visibility="{Binding IsSqlLogin, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding XrefUser, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ImportXref}"
                             Visibility="{Binding IsSqlLogin, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Grid.Row="4" Grid.Column="2" Content="Password..." Command="{Binding SetSqlPasswordCommand}"
                            Visibility="{Binding IsSqlLogin, Converter={StaticResource BooleanToVisibility}}" />

                    <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding XrefTrustServerCertificate}" IsEnabled="{Binding ImportXref}"
                              Content="Trust the server certificate (local development SQL Server)" />
                </Grid>
            </GroupBox>

            <!-- 3. Upload -->
            <GroupBox Grid.Row="3" Header="3. Upload" IsEnabled="{Binding IsIdle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Compression:" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding CompressionIndex}">
                        <ComboBoxItem Content="gzip" />
                        <ComboBoxItem Content="Brotli (smaller)" />
                        <ComboBoxItem Content="None" />
                    </ComboBox>
                    <Label Grid.Row="0" Grid.Column="2" Content="  Level:" />
                    <ComboBox Grid.Row="0" Grid.Column="3" SelectedIndex="{Binding LevelIndex}">
                        <ComboBoxItem Content="Fastest" />
                        <ComboBoxItem Content="Balanced" />
                        <ComboBoxItem Content="Smallest" />
                    </ComboBox>

                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" IsChecked="{Binding UseChunks}"
                              Content="Split into chunks (resends only a failed chunk)" />
                    <Label Grid.Row="1" Grid.Column="2" Content="  Chunk MiB:" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ChunkSizeMb, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseChunks}" />

                    <Label Grid.Row="2" Content="Parallel uploads:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ParallelUploads, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseChunks}" />

                    <CheckBox Grid.Row="3" Grid.ColumnSpan="5" IsChecked="{Binding RelativePaths}"
                              Content="Store file paths relative to PackagesLocalDirectory (hides this machine's folders)" />
                </Grid>
            </GroupBox>

            <!-- Run -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Index and Upload" Command="{Binding StartCommand}" FontWeight="SemiBold" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Stage}" Margin="0,0,0,4" />
                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Text="{Binding Checksum}" Margin="0,4,0,0" FontFamily="Consolas" />
            </StackPanel>

            <ListBox Grid.Row="5" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                     Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
        </Grid>
    </ScrollViewer>
</DataTemplate>
