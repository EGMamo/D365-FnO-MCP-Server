<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-process VisualStudio.Extensibility extension for Visual Studio 2022 17.14+
       and Visual Studio 2026. Building the .vsix needs Windows; the code compiles anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>D365FnoMcp.Extension</RootNamespace>
    <AssemblyName>D365FnoMcp.Extension</AssemblyName>
    <!-- The Output window API is marked preview; the Output pane is only a log copy, so a change there cannot break a run. -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_OUTPUTWINDOW</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>
  <ItemGroup>
    <!-- Remote UI loads each control's XAML from an embedded resource named after the control's type. -->
    <None Remove="UI\ToolSelectionControl.xaml" />
    <EmbeddedResource Include="UI\ToolSelectionControl.xaml" LogicalName="D365FnoMcp.Extension.UI.ToolSelectionControl.xaml" />
  </ItemGroup>
  <!-- Node.js and the Node gateway for custom models (scripts/bundle-vs-node-gateway.mjs), so a developer installs
       nothing. Packed only when the bundle has been built; without it the extension runs d365-fno-mcp-server from the PATH. -->
  <PropertyGroup>
    <NodeGatewayBundle>$(MSBuildThisFileDirectory)..\..\node-gateway\</NodeGatewayBundle>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NodeGatewayBundle)node.exe')">
    <Content Include="$(NodeGatewayBundle)**\*" Link="node-gateway\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\D365FnoMcp.Core\D365FnoMcp.Core.csproj" />
  </ItemGroup>
</Project>
