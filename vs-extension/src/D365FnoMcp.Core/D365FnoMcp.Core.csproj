<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that does not need Visual Studio: settings, .mcp.json, connection
       checks, CLI command lines and progress parsing. Tested on every OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>D365FnoMcp.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="D365FnoMcp.Core.Tests" />
  </ItemGroup>
  <!-- No FrameworkReference to Microsoft.AspNetCore.App: the Visual Studio extension host loads
       only Microsoft.NETCore.App, so anything from ASP.NET Core fails to load at run time. -->
</Project>
