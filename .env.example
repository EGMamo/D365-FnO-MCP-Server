# d365-fno-mcp-server configuration example.
# Copy to `.env` and adjust, or run `d365-fno-mcp-server setup`.

# The MCP server is exposed over authenticated HTTP.
MCP_TRANSPORT=http

# HTTP listen port (HTTP transport only).
MCP_PORT=3000

# Interface to bind (HTTP transport only). Empty binds every interface; use
# 127.0.0.1 to keep a local server off the network.
MCP_HOST=

# Named API keys for the HTTP transport: name=key entries separated by commas
# or newlines, each key at least 32 characters (e.g. `openssl rand -hex 32`).
# Only the name appears in logs. Example: alice=<64 hex chars>,bob=<64 hex chars>
MCP_API_KEYS=

# Single legacy key (reported under the name `default`). The HTTP transport
# needs at least one key from MCP_API_KEYS or MCP_API_KEY.
# Generate one with `openssl rand -hex 32` (or run `setup`, which does it for you).
MCP_API_KEY=

# Path to the D365 PackagesLocalDirectory. Required for `index` and `doctor`.
# Leave it empty on a server that receives a prebuilt index from its deployment
# pipeline; source-file fallback and per-file staleness checks are then disabled.
D365_PACKAGES_DIR=K:\AosService\PackagesLocalDirectory

# Four-part application version of the PackagesLocalDirectory above, e.g.
# 10.0.2645.136. Unified Developer Experience paths already name the version
# (...\Dynamics365\<version>\PackagesLocalDirectory) and are detected
# automatically; set this only for layouts that do not, such as the classic AOS
# path above. The server tells every session which version its index describes
# and warns when the two differ.
# D365_APP_VERSION=

# Location of the SQLite index file. Use an absolute path when an MCP client
# launches the server, because the client picks the working directory.
D365_INDEX_DB_PATH=./d365_index.db

# Optional immutable artifact-store root for hosted mode. At startup the server
# resolves deployment-pointers.json, validates the active bundle, copies its
# database to D365_INDEX_DB_PATH and opens that local snapshot read-only.
# D365_ARTIFACT_STORE_PATH=

# Where serve reads the active bundle. azure-blob pulls it from the container below at startup;
# D365_ARTIFACT_STORE_PATH then names an instance-local materialization directory.
# D365_ARTIFACT_SOURCE=local

# Azure Blob settings for D365_ARTIFACT_SOURCE=azure-blob and the artifact operator CLI.
# Authentication uses DefaultAzureCredential (managed identity in hosted automation).
# D365_ARTIFACT_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# D365_ARTIFACT_CONTAINER=d365-artifacts
# D365_ARTIFACT_MANAGED_IDENTITY_CLIENT_ID=
# D365_ARTIFACT_SERVER_VERSION=0.1.0
# D365_ARTIFACT_MIN_INDEX_SCHEMA_VERSION=1
# D365_ARTIFACT_MAX_INDEX_SCHEMA_VERSION=1
# Capabilities the active bundle must declare complete (serve and the artifact CLI).
# Empty requires the ones the indexer covers completely (none yet).
# D365_ARTIFACT_REQUIRED_CAPABILITIES=securityGraphs

# Set to 0 to reduce DB size by not storing full AOT XML in SQLite.
# get_element_xml then reads each object's indexed source file on demand, so the
# files must stay where they were indexed (it cannot on a server without them).
D365_INDEX_STORE_RAW_XML=1

# Set to 1 to enable table-extension preview/apply tools. Also requires an explicit model allowlist.
D365_ENABLE_WRITE_TOOLS=0

# Legacy alias for D365_CUSTOM_METADATA_DIR.
D365_PROJECT_DIR=

# Folder configured in Visual Studio under:
# Extensions > Dynamics 365 > Configure Metadata > Folder for your own custom metadata.
# Write tools create AOT XML only below this root and never overwrite existing files.
D365_CUSTOM_METADATA_DIR=

# Root containing the Visual Studio .sln/.slnx and Finance Operations .rnrproj files.
D365_VISUAL_STUDIO_WORKSPACE_DIR=

# Select a solution by relative/absolute path if the workspace has more than one.
D365_TARGET_SOLUTION=

# Optional defaults. Prefer a .rnrproj path when display names are ambiguous.
D365_TARGET_PROJECT=
D365_TARGET_PACKAGE=
D365_TARGET_MODEL=

# Comma-separated literal Package/Model pairs authorized for offline writes (spaces allowed).
# Empty means no model writes are authorized. Example: MyPackage/My Custom Model
D365_WRITABLE_MODELS=

# CLI-only settings (the server itself ignores them).
# SQL Server connections for index-xref and index-trace; use a read-only login.
# Trusted_Connection=yes needs the optional msnodesqlv8 driver (see the README).
# D365_XREF_CONNECTION_STRING=
# D365_TRACE_CONNECTION_STRING=
# Set to 1 to skip the prune magnitude guard (scan must overlap >=50% of the
# previously indexed objects). Zero-scan and parse-error guards still apply.
D365_BYPASS_PRUNE_GUARD=0

# Max requests per client IP per rate-limit window.
RATE_LIMIT_MAX_REQUESTS=500

# Rate-limit window in milliseconds (15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# Per-request timeout in milliseconds (2 minutes).
MCP_REQUEST_TIMEOUT_MS=120000

# Number of trusted reverse-proxy hops. 0 = ignore X-Forwarded-For (default).
TRUST_PROXY_HOPS=0

# Max simultaneous MCP sessions; further sessions receive HTTP 503.
MAX_CONCURRENT_SESSIONS=100

# Idle sessions are closed after this period (30 minutes).
SESSION_IDLE_TIMEOUT_MS=1800000

# Lowest level written to the structured stderr log: DEBUG, INFO, WARN, ERROR, FATAL or SILENT.
MCP_LOG_LEVEL=INFO

# =============================================================================
# Hybrid gateway (`d365-fno-mcp-server gateway`)
#
# A loopback MCP endpoint for your agent. It indexes only your custom models
# into a separate local SQLite index, forwards every other call to the hosted
# server and merges the local results in. Custom code never leaves this machine.
# The gateway also reads D365_CUSTOM_METADATA_DIR (legacy D365_PROJECT_DIR),
# D365_INDEX_DB_PATH, D365_APP_VERSION and the Visual Studio workspace settings
# (D365_VISUAL_STUDIO_WORKSPACE_DIR, D365_TARGET_*) set earlier in this file;
# the notes below say how it uses them. Write tools stay off.
# =============================================================================

# Hosted MCP endpoint the gateway forwards to (required). It must be https://
# unless the host is loopback (127.0.0.1, localhost, ::1). A URL without a path
# gets /mcp appended.
# D365_HOSTED_MCP_URL=https://<hosted-server>/mcp

# API key for the hosted server, sent as X-API-Key. Set exactly one of these two.
# Prefer the file form: it keeps the key out of the environment and out of shell
# history. The file holds the key alone; surrounding whitespace is trimmed. The
# key is never logged or printed.
# D365_HOSTED_API_KEY=
# D365_HOSTED_API_KEY_FILE=

# Folder holding your custom models (required): the gateway reads and indexes it.
# D365_CUSTOM_METADATA_DIR above is used; D365_PROJECT_DIR is only the legacy
# fallback when it is empty. The folder must exist.

# SQLite file for the custom-models index. Defaults to ./.d365/custom_index.db
# (resolved to an absolute path), or :memory: for tests. It must differ from
# D365_INDEX_DB_PATH, because the main index is never touched. The gateway token
# file is kept in the same folder.
# D365_LOCAL_INDEX_DB_PATH=./.d365/custom_index.db

# Loopback port the gateway listens on (1-65535). It always binds 127.0.0.1.
# D365_GATEWAY_PORT=3101

# Bearer token your agent presents to the gateway (at least 32 characters, no
# placeholder values; `openssl rand -hex 32` makes one). When unset, the gateway
# generates one on first start, keeps it in `gateway-token` next to the local
# index (mode 0600) and reuses it on every later start. It is never logged.
# D365_GATEWAY_TOKEN=

# Four-part application version of your own PackagesLocalDirectory, e.g.
# 10.0.2645.136 (see D365_APP_VERSION above). The gateway declares it to the
# hosted server, which warns when its index describes a different version.
# D365_APP_VERSION=

# Comma-separated object-name prefixes that must never be sent to the hosted
# server (for example your customer prefix). Calls naming an object with such a
# prefix are not forwarded. Other names, including custom ones in a search, may
# still reach the hosted server. Each entry is a plain prefix (letters, digits,
# underscores); wildcards or "@" would never match and are rejected.
# D365_GATEWAY_PRIVATE_PREFIXES=Contoso,Fabrikam

# Optional index of the standard application (a file built with the index
# command over your PackagesLocalDirectory). The gateway opens it read-only and
# lays the custom index over it, so the tools it would otherwise forward
# (security paths, SoD, diff_roles, entity readiness, BP findings, generators)
# run on this machine over both and send nothing upstream.
# D365_GATEWAY_STANDARD_INDEX_DB_PATH=

# How long to wait for the hosted server before the gateway falls back to local
# results with a warning, in milliseconds (1000-120000).
# D365_GATEWAY_UPSTREAM_TIMEOUT_MS=15000

# Fallback interval for re-checking the custom folder for edits, in milliseconds
# (1000-3600000), in case the file watcher misses a change.
# D365_GATEWAY_REINDEX_TTL_MS=30000

# The local get_visual_studio_workspace tool reads D365_VISUAL_STUDIO_WORKSPACE_DIR
# and D365_TARGET_SOLUTION, _PROJECT, _PACKAGE and _MODEL exactly as `serve`
# does (all optional, see above).
